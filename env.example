# Copy to .env and fill in once you have confirmed values.
# Do not commit the real .env file.

# Robinhood Chain's RPC URL, chain ID, and block explorer are confirmed
# (see https://docs.robinhood.com/chain/connecting) and already hardcoded
# as defaults in hardhat.config.js for the "robinhoodTestnet" and
# "robinhoodMainnet" networks — you don't need to set anything here to use
# them. Only set these if you want to override the public RPC with a
# dedicated one (Robinhood's docs recommend Alchemy — e.g.
# https://robinhood-testnet.g.alchemy.com/v2/{API_KEY} — since the public
# endpoints are rate-limited and not meant for production use).
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=

DEPLOYER_PRIVATE_KEY=

# Real DEX router on Robinhood Chain (Uniswap V2-style: needs
# addLiquidityETH, factory(), WETH(), and both
# swapExactETHForTokensSupportingFeeOnTransferTokens and
# swapExactTokensForETHSupportingFeeOnTransferTokens — required because
# "Launch + Add Liquidity" tokens carry a transfer tax, and the plain swap
# functions aren't safe against a fee-on-transfer token).
#
# MAINNET (chain 4663) already has a confirmed default baked into
# deploy.js — Uniswap V2 Router02 at 0x89e5DB8B5aA49aA85AC63f691524311AEB649eba,
# cross-checked against Uniswap Labs' own official @uniswap/sdk-core npm
# package and against robinhoodchain.blockscout.com showing it as a verified
# "UniswapV2Router02" contract. You don't need to set this to deploy to
# robinhoodMainnet. deploy.js also double-checks it live on-chain (calls the
# router's own factory() and compares it) before deploying anything, so a
# bad override here gets caught before it costs any gas.
#
# TESTNET (chain 46630) has NO confirmed default — Robinhood Chain's testnet
# explorer turns up 15 different contracts all separately verified under the
# name "UniswapV2Router02" (anyone can deploy and verify a copy of the
# public Uniswap V2 source), with no way to tell which one, if any, real
# liquidity actually routes through. deploy.js will refuse to run against
# robinhoodTestnet until you set this yourself from a source you trust (e.g.
# Uniswap's own app/interface pointed at Robinhood Chain testnet) — do not
# guess one of the 15.
#
# Only set this env var at all if you want to override the mainnet default
# above, or once you've confirmed a real testnet router.
DEX_ROUTER_ADDRESS=

# Protocol treasury that receives deployment/launch fees.
FEE_TREASURY_ADDRESS=

# "Deploy Token" and "Deploy and Add Liquidity (Launch)" are billed
# separately — $50 and $100 respectively. The contract only stores a fixed
# wei amount for each (it has no live price awareness of its own), so
# deploy.js converts those USD targets to wei using a live ETH price it
# fetches at deploy time. Leave both blank to let it do that automatically;
# set either here (in wei) only if you want an exact amount instead — e.g.
# DEPLOY_FEE_WEI=16600000000000000 for roughly $50 at $3,012/ETH.
DEPLOY_FEE_WEI=
LAUNCH_FEE_WEI=

# ETH's price moves, but these on-chain fees don't update themselves —
# scripts/updateFees.js re-fetches a live price and calls
# setDeployFee()/setLaunchFee() if either has drifted from its $50/$100
# target past a tolerance. Run it by hand or on a schedule (e.g. hourly
# cron) once a factory is deployed:
#   TOKEN_FACTORY_ADDRESS=0x... npx hardhat run scripts/updateFees.js --network robinhoodMainnet

# How long LP tokens stay locked after a "Deploy and Add Liquidity
# (Launch)" launch, in seconds. Example below is 15 days.
LP_LOCK_DURATION_SECONDS=1296000

# --- Transfer tax ("Deploy and Add Liquidity (Launch)" path only) ---
# Where the 0.25% buy/sell transfer tax gets sent while a pool's tax is
# still active. "Deploy Token" tokens never have a tax at all.
PLATFORM_FEE_WALLET_ADDRESS=

# A Chainlink ETH/USD price feed (AggregatorV3Interface) on Robinhood
# Chain. The tax's auto-disable check (once a pool's live market cap hits
# $80,000) depends on this.
#
# MAINNET (chain 4663) already has a confirmed default baked into
# deploy.js — Chainlink ETH/USD "Standard Proxy" at
# 0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9, read directly off Chainlink's
# own address directory (https://docs.chain.link/data-feeds/price-feeds/
# addresses?network=robinhood), which Robinhood's own docs name as the
# source of truth for these. You don't need to set this to deploy to
# robinhoodMainnet. deploy.js also double-checks it live on-chain (calls
# decimals()/latestRoundData() and sanity-checks the answer) before
# deploying anything.
#
# TESTNET (chain 46630) has NO confirmed default — leave this unset and
# deploy.js will refuse to run against robinhoodTestnet until you've pulled
# the real ETH/USD Standard Proxy address for testnet from that same
# Chainlink directory yourself (it's JS-rendered, so it has to be opened in
# an actual browser — a plain fetch only gets an empty shell).
#
# Only set this env var at all if you want to override the mainnet default
# above, or once you've confirmed a real testnet feed. Use the "Standard
# Proxy" address, not the separate "SVR Proxy" the same page lists — that's
# a distinct MEV-aware feed, not what a plain price read expects.
PRICE_FEED_ADDRESS=

# Everything else about the tax (graduation target in USD, fee bps, oracle
# staleness tolerance) has sane defaults set directly in TokenFactory's
# constructor and can be changed afterward via setTaxDefaults() — see the
# README.

# --- Contract verification ---
# Robinhood Chain's block explorer is confirmed to be Blockscout-based
# (robinhoodchain.blockscout.com for mainnet, explorer.testnet.chain.
# robinhood.com for testnet), with apiURL/browserURL already hardcoded in
# hardhat.config.js. Blockscout's Etherscan-compatible API accepts any
# non-empty string as the API key (Robinhood's own docs use the literal
# string "empty") — hardhat.config.js already defaults to that. Only set
# this if that ever changes.
EXPLORER_API_KEY=

# --- Gasless relayer (scripts/relayer.js) — only needed if you run it ---
# A wallet YOU generate and fund, used only to submit relayed
# deploy/launch transactions and pay their gas. This is a SEPARATE key from
# DEPLOYER_PRIVATE_KEY above — never reuse a key across the two roles, and
# never reuse this key anywhere else. This repo does not generate, fund, or
# store this key for you; treat it with the same care as any hot wallet
# that holds real ETH, since whoever holds it can spend its balance. Its
# address must also be set on-chain via TokenFactory.setRelayer(...) /
# CustomTokenFactory.setRelayer(...) (owner-only) before relayedCreateToken/
# relayedCreateCustomToken calls from it will succeed — see the README's
# "Gasless relayed launches" section for the full trust model (this wallet
# can only ever relay exactly what a creator signed and escrowed; it can
# never touch a creator's deposit beyond that).
RELAYER_PRIVATE_KEY=
TOKEN_FACTORY_ADDRESS=
CUSTOM_TOKEN_FACTORY_ADDRESS=
PORT=8787

# Only needed if you run the relayer via `node scripts/relayer.js` / `npm
# start` (e.g. on a managed Node.js host) instead of
# `npx hardhat run scripts/relayer.js --network <network>` — without the
# CLI's --network flag choosing it for you, Hardhat reads the active
# network from this variable instead. Set it to whichever network name
# from hardhat.config.js you're relaying for (e.g. robinhoodMainnet or
# robinhoodTestnet). See the README's "Deploying the relayer on a managed
# Node.js host" section.
HARDHAT_NETWORK=

# Redirect the relayer's two JSON-file data directories (voucher/cursor
# bookkeeping, and the launch ledger) away from their project-relative
# defaults — only needed if your host's default app directory doesn't
# survive a redeploy/restart. Leave both blank to use the defaults
# (relayer-data/ and deployed-contracts/ under the repo root).
RELAYER_DATA_DIR=
DEPLOYED_CONTRACTS_DIR=
